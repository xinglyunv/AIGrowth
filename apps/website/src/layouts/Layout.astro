---
import '../styles/global.css';
import { loadSiteConfig } from '../lib/site-config';

export interface Props {
  title?: string;
  description?: string;
}

const settings = await loadSiteConfig();
const { title = settings.seo.title, description = settings.seo.description } = Astro.props;

---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-white flex flex-col min-h-svh">
    <header
      class="fixed top-0 z-50 w-full border-b border-primary-200/50 bg-white/90 backdrop-blur-xl transition-all duration-300"
    >
      <div class="w-full mx-auto px-6 max-w-7xl lg:px-12">
        <div class="relative flex flex-col w-full py-4 mx-auto lg:items-center lg:justify-between lg:flex-row lg:px-6">
          <div class="flex flex-row items-center justify-between lg:justify-start">
            <a href="/" class="inline-flex items-center gap-2.5">
              {settings.logo_url ? <img src={settings.logo_url} alt={settings.site_name} class="h-8 w-auto" /> : <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent-400 to-primary-900 flex items-center justify-center text-white font-bold text-sm">A</div>}
              <span class="font-bold text-base-900 text-lg tracking-tight">{settings.site_name}</span>
            </a>
          </div>
          <nav
            id="main-navigation"
            class="hidden flex-col items-center flex-grow gap-4 overflow-hidden pb-3 lg:flex lg:flex-row lg:justify-center lg:gap-8 lg:pb-0"
          >
            {settings.navigation.items.map((item, index) => <a href={item.href} class="text-sm font-medium text-base-500 transition hover:text-primary-900 relative after:absolute after:-bottom-1 after:left-0 after:w-0 after:h-0.5 after:bg-accent-500 after:transition-all hover:after:w-full" class:list={{ 'lg:ml-auto': index === 0 }}>{item.label}</a>)}
            <div class="inline-flex items-center gap-3 list-none py-px lg:ml-auto">
              <a href={settings.navigation.login_href} class="inline-flex items-center justify-center rounded-xl px-5 py-2.5 text-sm font-semibold text-base-600 bg-white/80 hover:bg-white ring-1 ring-base-200/50 hover:ring-base-300 transition">{settings.navigation.login_label}</a>
              <a href={settings.navigation.cta_href} class="inline-flex items-center justify-center rounded-xl px-5 py-2.5 text-sm font-semibold bg-gradient-to-r from-accent-500 to-primary-800 text-white hover:shadow-lg hover:shadow-accent-500/25 transition shadow-md">{settings.navigation.cta_label}</a>
            </div>
          </nav>
        </div>
      </div>
    </header>

    <main class="grow"><slot /></main>

    <footer class="bg-base-950 text-base-300">
      <div class="px-6 py-16 mx-auto max-w-7xl lg:px-12">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
          <div class="col-span-2 md:col-span-2">
            <div class="flex items-center gap-2.5 mb-4">
              {settings.logo_url ? <img src={settings.logo_url} alt={settings.site_name} class="h-8 w-auto" /> : <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent-400 to-primary-700 flex items-center justify-center text-white font-bold text-sm">A</div>}
              <span class="font-bold text-white text-lg tracking-tight">{settings.site_name}</span>
            </div>
             <p class="text-sm text-base-400 leading-relaxed max-w-xs">{settings.footer.description}</p>
            <div class="flex items-center gap-3 mt-6">
              <a href="#" class="w-9 h-9 rounded-lg bg-base-800 hover:bg-accent-600 flex items-center justify-center text-base-400 hover:text-white transition"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg></a>
              <a href="#" class="w-9 h-9 rounded-lg bg-base-800 hover:bg-accent-600 flex items-center justify-center text-base-400 hover:text-white transition"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 0021.565-4.725 13.717 13.717 0 001.414-5.926c0-.209 0-.416-.015-.622A9.847 9.847 0 0024 4.59z"/></svg></a>
              <a href="#" class="w-9 h-9 rounded-lg bg-base-800 hover:bg-accent-600 flex items-center justify-center text-base-400 hover:text-white transition"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
            </div>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white mb-4">产品</h4>
            <ul class="space-y-3">
              <li><a href="/features" class="text-sm text-base-400 hover:text-white transition">功能</a></li>
              <li><a href="/pricing" class="text-sm text-base-400 hover:text-white transition">定价</a></li>
              <li><a href="/resources" class="text-sm text-base-400 hover:text-white transition">资源</a></li>
              <li><a href="/changelog" class="text-sm text-base-400 hover:text-white transition">更新日志</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white mb-4">公司</h4>
            <ul class="space-y-3">
              <li><a href="/about" class="text-sm text-base-400 hover:text-white transition">关于</a></li>
              <li><a href="/blog" class="text-sm text-base-400 hover:text-white transition">博客</a></li>
              <li><a href="/careers" class="text-sm text-base-400 hover:text-white transition">加入我们</a></li>
              <li><a href="/contact" class="text-sm text-base-400 hover:text-white transition">联系我们</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-white mb-4">法律</h4>
            <ul class="space-y-3">
              <li><a href="/privacy" class="text-sm text-base-400 hover:text-white transition">隐私政策</a></li>
              <li><a href="/terms" class="text-sm text-base-400 hover:text-white transition">服务条款</a></li>
              <li><a href="/security" class="text-sm text-base-400 hover:text-white transition">安全合规</a></li>
            </ul>
          </div>
        </div>
        <div class="pt-8 mt-12 border-t border-base-800 flex flex-col md:flex-row justify-between items-center text-sm text-base-500">
          <p>{settings.footer.copyright || settings.footer_text}</p>
          <p class="mt-3 md:mt-0 text-base-600">{settings.site_name} &mdash; {settings.site_description}</p>
        </div>
      </div>
    </footer>

    <script is:inline defer src="https://unpkg.com/alpinejs@3.10.5/dist/cdn.min.js"></script>

    <script>
      async function loadConfig() {
        try {
          const res = await fetch('/api/v1/settings');
          const data = await res.json();
          if (!data.success) return;
           const cfg = data.data;
            document.body.classList.remove('theme-syntro', 'theme-saas-ui', 'theme-hikari', 'theme-cruip', 'theme-nextly', 'theme-saas-landing');
            const themes = ['syntro', 'saas-ui', 'hikari', 'cruip', 'nextly', 'saas-landing'];
            document.body.classList.add(themes.includes(cfg.site_theme) ? 'theme-' + cfg.site_theme : 'theme-syntro');
          if (cfg.site_title) document.title = cfg.site_title + ' - AI Growth Engine';
          const setText = (sel, val) => { if (!val) return; document.querySelectorAll(sel).forEach(el => el.textContent = val); };
          setText('[data-site-name]', cfg.site_name);
          setText('[data-site-desc]', cfg.site_description);
          setText('[data-footer-text]', '\u00A9 ' + new Date().getFullYear() + ' ' + cfg.footer_text);
          setText('[data-contact-email]', cfg.contact_email);
          setText('[data-contact-phone]', cfg.contact_phone);
          setText('[data-contact-address]', cfg.contact_address);
          setText('[data-working-hours]', cfg.working_hours);
          setText('[data-hero-tagline]', cfg.hero_tagline);
          setText('[data-hero-title]', cfg.hero_title);
          setText('[data-hero-subtitle]', cfg.hero_subtitle);
          setText('[data-stat-companies]', cfg.stat_companies);
          setText('[data-stat-models]', cfg.stat_models);
          setText('[data-stat-reports]', cfg.stat_reports);
          setText('[data-stat-accuracy]', cfg.stat_accuracy);
          if (cfg.logo_url) {
            document.querySelectorAll('[data-logo]').forEach(el => {
              el.outerHTML = '<img src="' + cfg.logo_url + '" alt="' + cfg.site_name + '" class="h-7 w-auto" />';
            });
          }
        } catch(e) {}
      }
      loadConfig();
    </script>
  </body>
</html>
