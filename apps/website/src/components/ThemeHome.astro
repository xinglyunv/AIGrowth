---
import { loadSiteConfig } from '../lib/site-config';

const config = await loadSiteConfig();
const theme = config.site_theme;

const features = config.features.map((feature, index) => [String(index + 1).padStart(2, '0'), feature.title, feature.description]);
const featureHrefs = config.features.map((feature) => feature.href);
const stats = config.stats.items;

const models = config.trust.items;
---

<div class={`theme-home theme-home--${theme}`} style={`--theme-primary:${config.theme.primary};--theme-accent:${config.theme.accent};--theme-surface:${config.theme.surface};--theme-text:${config.theme.text};--theme-muted:${config.theme.muted};`}>
  {theme === 'syntro' && <div class="theme-section">
      <section class="syn-hero">
        <div class="syn-grid"></div>
        <div class="syn-orb syn-orb-one"></div><div class="syn-orb syn-orb-two"></div>
        <div class="home-shell syn-hero-grid">
          <div class="syn-copy">
             <span class="eyebrow"><i></i> {config.hero.tagline}</span>
             <h1>{config.hero.title}</h1>
             <p>{config.hero.subtitle}</p>
             <div class="hero-actions"><a class="button button-dark" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="text-link" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div>
             <div class="syn-proof">{stats.slice(0, 2).map((stat) => <><strong>{stat.value}</strong><span>{stat.label}</span></>)}</div>
          </div>
          <div class="syn-dashboard" aria-label="品牌可见度分析面板">
            <div class="window-bar"><span></span><span></span><span></span><b>visibility / overview</b></div>
             <div class="score-card"><div><small>{config.hero.tagline}</small><strong>{config.dashboard.score}</strong><label>{config.dashboard.score_delta} <span>{config.dashboard.trend_label}</span></label></div><div class="score-ring">{config.dashboard.score}<span>/100</span></div></div>
             <div class="signal-row"><div><small>AI mentions</small><strong>{config.dashboard.mentions}</strong></div><div><small>Recommendation rate</small><strong>{config.dashboard.recommendation_rate}</strong></div><div><small>Competitor gap</small><strong>{config.dashboard.competitor_gap}</strong></div></div>
             <div class="chart"><div class="chart-label"><span>{config.hero.tagline}</span><small>{config.dashboard.trend_label}</small></div><svg viewBox="0 0 500 150" role="img" aria-label="品牌可见度上升趋势"><path d="M0 126 C55 118 66 111 103 116 S157 88 194 99 S244 68 281 81 S333 39 365 53 S424 20 500 14" fill="none" stroke="currentColor" stroke-width="4"/><path d="M0 126 C55 118 66 111 103 116 S157 88 194 99 S244 68 281 81 S333 39 365 53 S424 20 500 14 V150 H0Z" fill="currentColor" opacity=".1"/></svg></div>
          </div>
        </div>
      </section>
      <section class="syn-strip"><div class="home-shell"><span>Trusted by modern brand teams</span>{models.slice(0, 4).map((model) => <b>{model}</b>)}</div></section>
       <section class="syn-section" id="features"><div class="home-shell"><div class="section-intro"><span class="eyebrow">{config.hero.tagline}</span><h2>{config.hero.title}</h2><p>{config.hero.subtitle}</p></div><div class="syn-feature-grid">{features.map(([number, title, description], index) => <article><span>{number}</span><h3>{title}</h3><p>{description}</p><a href={featureHrefs[index]}>了解更多</a></article>)}</div></div></section>
       <section class="syn-cta"><div class="home-shell"><span class="eyebrow">{config.hero.tagline}</span><h2>{config.hero.title}</h2><a class="button button-light" href={config.hero.primary_href}>{config.hero.primary_label}</a></div></section>
    </div>}

  {theme === 'saas-landing' && <div class="theme-section">
       <section class="landing-hero"><div class="home-shell landing-shell"><div class="landing-copy"><span class="landing-pill">{config.hero.tagline}</span><h1>{config.hero.title}</h1><p>{config.hero.subtitle}</p><div class="hero-actions"><a class="button button-indigo" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="landing-quiet" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div><small>{config.site_name}</small></div><div class="landing-art"><div class="landing-bubble bubble-a">{stats[0].label} <b>{stats[0].value}</b></div><div class="landing-bubble bubble-b">{stats[1].label} <b>{stats[1].value}</b></div><div class="landing-panel"><div class="landing-panel-top"><span>{config.hero.tagline}</span><b>{stats[2].value}</b></div><div class="bars"><i style="height:42%"></i><i style="height:57%"></i><i style="height:49%"></i><i style="height:72%"></i><i style="height:66%"></i><i style="height:88%"></i><i style="height:78%"></i><i style="height:100%"></i></div><div class="panel-axis"><span>01</span><span>07</span><span>14</span><span>21</span><span>30</span></div></div></div></div></section>
      <section class="landing-logos"><div class="home-shell"><span>Built for teams shaping category narratives</span><div>{models.map((model) => <b>{model}</b>)}</div></div></section>
       <section class="landing-section" id="features"><div class="home-shell"><div class="landing-heading"><span>{config.hero.tagline}</span><h2>{config.hero.title}</h2></div><div class="landing-cards">{features.map(([number, title, description]) => <article><span class="card-number">{number}</span><h3>{title}</h3><p>{description}</p><div class="mini-arrow" aria-hidden="true"></div></article>)}</div></div></section>
       <section class="landing-bottom"><div class="home-shell"><h2>{config.hero.title}</h2><a class="button button-white" href={config.hero.primary_href}>{config.hero.primary_label}</a></div></section>
    </div>}

  {theme === 'saas-ui' && <div class="theme-section">
       <section class="ui-hero"><div class="home-shell ui-layout"><div class="ui-copy"><span class="ui-kicker"><i></i> {config.hero.tagline}</span><h1>{config.hero.title}</h1><p>{config.hero.subtitle}</p><div class="hero-actions"><a class="button button-lime" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="ui-link" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div><div class="ui-note"><span class="avatar-stack"><i></i><i></i><i></i></span><span>{stats[0].value} {stats[0].label}</span></div></div><div class="ui-board"><div class="ui-sidebar"><b>AGE</b><span class="active">Overview</span><span>Projects</span><span>Reports</span><span>Models</span><small>WORKSPACE</small><span>Settings</span></div><div class="ui-main"><div class="ui-main-head"><span>Overview</span><small>{config.site_name}</small></div><div class="ui-metrics"><div><small>{stats[3].label}</small><strong>{stats[3].value}</strong><em>Improving</em></div><div><small>{stats[0].label}</small><strong>{stats[0].value}</strong><em>Tracking</em></div></div><div class="ui-line"><span>{config.hero.tagline}</span><svg viewBox="0 0 400 100"><path d="M0 78 C32 65 44 81 72 63 S115 70 140 45 S187 59 218 37 S260 40 292 25 S347 42 400 12" fill="none" stroke="currentColor" stroke-width="3"/></svg></div></div></div></div></section>
      <section class="ui-feature"><div class="home-shell"><span class="ui-kicker">Made for focus</span><h2>Signal over noise.</h2><div class="ui-feature-grid">{features.map(([number, title, description]) => <article><strong>{number}</strong><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
    </div>}

  {theme === 'hikari' && <div class="theme-section">
       <section class="hikari-hero"><div class="hikari-sun"></div><div class="home-shell hikari-layout"><div class="hikari-label">{config.hero.tagline}</div><h1>{config.hero.title}</h1><p>{config.hero.subtitle}</p><div class="hero-actions"><a class="button button-ink" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="hikari-link" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div><div class="hikari-stamp">{stats[0].value}<br /><b>{stats[0].label}</b></div></div></section>
       <section class="hikari-story" id="hikari-story"><div class="home-shell hikari-story-grid"><div><span class="hikari-label">01 / THE SHIFT</span><h2>{config.hero.title}</h2></div><div><p>{config.hero.subtitle}</p><p>{config.site_name} 将这些变化拆成可追踪的指标，让营销团队每天都能知道下一步该做什么。</p><a class="hikari-link" href="/features">查看平台能力</a></div></div></section>
      <section class="hikari-numbers"><div class="home-shell"><div><strong>10+</strong><span>模型</span></div><div><strong>82.4</strong><span>平均可见度分</span></div><div><strong>24.1%</strong><span>推荐率提升</span></div></div></section>
       <section class="hikari-end"><div class="home-shell"><span class="hikari-label">{config.hero.tagline}</span><h2>{config.hero.title}</h2><a class="button button-ink" href={config.hero.primary_href}>{config.hero.primary_label}</a></div></section>
    </div>}

  {theme === 'cruip' && <div class="theme-section">
       <section class="cruip-hero"><div class="cruip-noise"></div><div class="home-shell cruip-copy"><span class="cruip-pill"><i></i> {config.hero.tagline}</span><h1>{config.hero.title}</h1><p>{config.hero.subtitle}</p><div class="hero-actions"><a class="button button-cyan" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="cruip-video" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div><div class="cruip-orbit orbit-one"></div><div class="cruip-orbit orbit-two"></div><div class="cruip-card"><small>{stats[0].label}</small><strong>{stats[0].value}</strong><span>{config.hero.tagline}</span><div class="cruip-spark"></div></div></div></section>
       <section class="cruip-proof" id="cruip-proof"><div class="home-shell"><div class="cruip-proof-head"><span>{config.hero.tagline}</span><h2>{config.hero.title}</h2></div><div class="cruip-proof-grid">{features.map(([number, title, description], index) => <article><span>{number}</span><h3>{title}</h3><p>{description}</p><a href={featureHrefs[index]}>Learn more</a></article>)}</div></div></section>
       <section class="cruip-cta"><div class="home-shell"><span class="cruip-pill">{config.hero.tagline}</span><h2>{config.hero.title}</h2><a class="button button-cyan" href={config.hero.primary_href}>{config.hero.primary_label}</a></div></section>
    </div>}

  {theme === 'nextly' && <div class="theme-section">
       <section class="nextly-hero"><div class="nextly-glow"></div><div class="home-shell nextly-copy"><span class="nextly-badge">{config.hero.tagline}</span><h1>{config.hero.title}</h1><p>{config.hero.subtitle}</p><div class="hero-actions"><a class="button button-purple" href={config.hero.primary_href}>{config.hero.primary_label}</a><a class="nextly-link" href={config.hero.secondary_href}>{config.hero.secondary_label}</a></div><div class="nextly-window"><div class="window-bar"><span></span><span></span><span></span><b>{config.site_name}</b></div><div class="nextly-window-body"><div class="nextly-score"><small>{stats[3].label}</small><strong>{stats[3].value}</strong><em>{stats[0].label}</em></div><div class="nextly-bars"><i style="height:35%"></i><i style="height:54%"></i><i style="height:47%"></i><i style="height:72%"></i><i style="height:81%"></i><i style="height:94%"></i></div></div></div></div></section>
       <section class="nextly-features" id="nextly-features"><div class="home-shell"><span class="nextly-overline">{config.hero.tagline}</span><h2>{config.hero.title}</h2><div class="nextly-grid">{features.map(([number, title, description], index) => <article><div class="nextly-icon">{number}</div><h3>{title}</h3><p>{description}</p><a href={featureHrefs[index]}>Learn more</a></article>)}</div></div></section>
       <section class="nextly-cta"><div class="home-shell"><h2>{config.hero.title}</h2><p>{config.hero.subtitle}</p><a class="button button-purple" href={config.hero.primary_href}>{config.hero.primary_label}</a></div></section>
    </div>}
</div>

<style>
  .theme-home { --ink:var(--theme-text,#10213f); --muted:var(--theme-muted,#64748b); --line:#dce5ef; --surface:var(--theme-surface,#f7faff); color:var(--ink); overflow:hidden; }
  .home-shell { width:min(1180px, calc(100% - 48px)); margin:0 auto; position:relative; }
  .hero-actions { display:flex; align-items:center; gap:24px; flex-wrap:wrap; margin-top:32px; }
  .button { display:inline-flex; align-items:center; gap:18px; border-radius:10px; padding:14px 20px; font-size:14px; font-weight:700; transition:transform .2s, box-shadow .2s; }
  .button:hover { transform:translateY(-2px); }
  .button span { font-size:18px; line-height:1; }
  .button-dark { background:#14233d; color:#fff; box-shadow:0 14px 30px #0c1a3033; }
  .button-light,.button-white { background:#fff; color:#10213f; }
  .eyebrow { color:#80a2ca; font:700 11px/1.2 ui-monospace, SFMono-Regular, monospace; letter-spacing:.16em; text-transform:uppercase; }
  .eyebrow i { display:inline-block; width:7px; height:7px; border-radius:50%; background:#74d9bb; margin-right:8px; }
  .syn-hero { min-height:760px; display:flex; align-items:center; background:#edf5fb; position:relative; padding:145px 0 100px; }
  .syn-grid { position:absolute; inset:0; opacity:.52; background-image:linear-gradient(#d9e7f2 1px,transparent 1px),linear-gradient(90deg,#d9e7f2 1px,transparent 1px); background-size:56px 56px; mask-image:linear-gradient(to bottom,#000,transparent 80%); }
  .syn-orb { position:absolute; border-radius:50%; filter:blur(4px); opacity:.65; }.syn-orb-one { width:360px;height:360px; background:#bff1e1; top:15%;left:-180px; }.syn-orb-two { width:280px;height:280px; background:#d2dcff; right:-100px;bottom:8%; }
  .syn-hero-grid { display:grid; grid-template-columns:1fr 1.05fr; align-items:center; gap:70px; z-index:1; }.syn-copy h1 { max-width:600px; margin:24px 0 22px; font-size:clamp(46px,6vw,78px); line-height:1.03; letter-spacing:-.065em; }.syn-copy h1 em { color:#5778a6; font-style:normal; }.syn-copy p { max-width:510px; color:#657a97; font-size:18px; line-height:1.7; }.text-link,.syn-copy .text-link { color:#536d91;font-size:14px;font-weight:700; }.text-link span { margin-left:10px;color:#74bfae; }.syn-proof { display:flex; align-items:baseline; gap:8px; margin-top:64px; color:#7b8fa8; font-size:11px; }.syn-proof strong { color:#19365c; font-size:23px; margin-left:22px; }.syn-proof strong:first-child { margin-left:0; }.syn-dashboard { background:#fff; border:1px solid #dbe6f0; border-radius:18px; box-shadow:0 35px 90px #4c6f9130; padding:14px; transform:rotate(1.5deg); }.window-bar { display:flex; gap:6px; align-items:center; padding:4px 5px 14px; color:#9aabc0; font:10px ui-monospace,monospace; }.window-bar span { width:7px;height:7px;border-radius:50%;background:#d9e4ee; }.window-bar b { margin-left:auto;font-weight:500; }.score-card,.signal-row { display:flex; justify-content:space-between; gap:12px; background:#f6f9fc; border-radius:12px; padding:22px; }.score-card small,.signal-row small,.chart small { color:#8295aa; font-size:10px; display:block; text-transform:uppercase; letter-spacing:.08em; }.score-card strong { display:block; font-size:48px; letter-spacing:-.08em; margin:6px 0; }.score-card label { color:#3db58f; font-size:11px; }.score-card label span { color:#93a2b1; margin-left:6px; }.score-ring { width:66px;height:66px;border:5px solid #7ed6bd;border-left-color:#e2eaf0;border-radius:50%; display:flex;align-items:center;justify-content:center; font-size:16px;font-weight:800; color:#2c967e; }.score-ring span { font-size:9px;color:#95a5b5;margin-left:2px; }.signal-row { margin-top:12px;background:#fff;border:1px solid #edf1f5; }.signal-row strong { display:block;margin-top:7px;font-size:17px; }.chart { padding:24px 14px 8px; color:#54bba2; }.chart-label { display:flex;justify-content:space-between;color:#304a6a;font-size:12px;font-weight:700; }.chart svg { width:100%;height:auto;margin-top:15px; }.syn-strip { background:#fff;border-bottom:1px solid #e3ebf2; }.syn-strip .home-shell { min-height:100px;display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap; }.syn-strip span { color:#94a7bd;font-size:11px;text-transform:uppercase;letter-spacing:.12em; }.syn-strip b { color:#afbdcc;font-size:17px; }.syn-section { padding:130px 0;background:#fff; }.section-intro { max-width:560px; }.section-intro h2 { font-size:clamp(36px,4vw,58px);line-height:1.05;letter-spacing:-.06em;margin:22px 0 16px; }.section-intro p { color:#71849b;line-height:1.7; }.syn-feature-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:70px; }.syn-feature-grid article { padding:28px 0;border-top:1px solid #ccd9e7; }.syn-feature-grid article > span { color:#72bda7;font:12px ui-monospace,monospace; }.syn-feature-grid h3 { margin:45px 0 12px;font-size:21px; }.syn-feature-grid p { color:#71849b;line-height:1.7;font-size:14px;min-height:72px; }.syn-feature-grid a { color:#47769a;font-size:13px;font-weight:700; }.syn-feature-grid a span { color:#69bea5;margin-left:8px; }.syn-cta { background:#152b4c;color:#fff;padding:110px 0;text-align:center; }.syn-cta .eyebrow { color:#8bb5d0; }.syn-cta h2 { font-size:clamp(38px,5vw,68px);letter-spacing:-.06em;margin:18px auto 32px; }

  .landing-hero { background:#f5f4ff; padding:160px 0 100px; }.landing-shell { display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center; }.landing-pill,.landing-heading span,.landing-bottom .landing-pill { color:#6655df;font:800 11px ui-monospace,monospace;letter-spacing:.15em; }.landing-copy h1 { font-size:clamp(45px,6vw,78px);line-height:1.03;letter-spacing:-.07em;margin:22px 0; }.landing-copy mark { color:#6e5fe5;background:transparent; }.landing-copy p { color:#68708a;font-size:18px;line-height:1.7;max-width:520px; }.button-indigo { color:#fff;background:#6557dc;box-shadow:0 16px 32px #6557dc3d; }.landing-quiet { color:#4f516e;font-weight:700;font-size:14px; }.landing-copy > small { display:block;color:#9b9bb3;font-size:11px;margin-top:20px; }.landing-art { min-height:420px;position:relative; }.landing-panel { position:absolute;inset:55px 20px 10px;background:#fff;border-radius:18px;padding:25px;box-shadow:0 32px 80px #6655df2e; }.landing-panel-top { display:flex;justify-content:space-between;color:#43435a;font-size:13px;font-weight:700; }.landing-panel-top b { color:#38b98e; }.bars { height:235px;display:flex;align-items:end;gap:13px;padding:28px 18px 0;border-bottom:1px solid #e5e5f0; }.bars i { flex:1;border-radius:7px 7px 0 0;background:linear-gradient(#a69aef,#d6d2fc); }.bars i:last-child { background:#6758df; }.panel-axis { display:flex;justify-content:space-between;color:#aaa9bd;font-size:10px;margin-top:11px; }.landing-bubble { position:absolute;z-index:2;background:#fff;border-radius:10px;box-shadow:0 17px 32px #57529926;color:#56566a;font-size:11px;padding:12px 15px; }.landing-bubble b { display:block;color:#6858dd;font-size:18px;margin-top:5px; }.bubble-a { top:15px;right:0; }.bubble-b { left:-20px;bottom:42px; }.landing-logos { background:#fff;padding:28px 0;border-bottom:1px solid #ecebf7; }.landing-logos .home-shell { display:flex;justify-content:space-between;align-items:center;gap:30px;flex-wrap:wrap; }.landing-logos span { color:#a5a4b8;font-size:11px; }.landing-logos div { display:flex;gap:30px;color:#b2b0c9;font-weight:800; }.landing-section { background:#fff;padding:120px 0; }.landing-heading h2 { max-width:650px;font-size:clamp(38px,5vw,62px);letter-spacing:-.07em;line-height:1.06;margin-top:20px; }.landing-cards { display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:65px; }.landing-cards article { background:#fafaff;border:1px solid #eae9f5;padding:30px;min-height:260px;position:relative;border-radius:12px; }.card-number { color:#7064df;font:12px ui-monospace,monospace; }.landing-cards h3 { margin-top:68px;font-size:21px; }.landing-cards p { color:#77768b;font-size:14px;line-height:1.7;margin-top:10px; }.mini-arrow { position:absolute;right:28px;bottom:28px;color:#6e61e2;font-size:20px; }.landing-bottom { background:#29204d;color:#fff;text-align:center;padding:100px 0; }.landing-bottom h2 { font-size:clamp(38px,5vw,67px);letter-spacing:-.06em;max-width:700px;margin:0 auto 34px; }.button-white { display:inline-flex; }

  .ui-hero { background:#f5f7f8;padding:155px 0 100px; }.ui-layout { display:grid;grid-template-columns:.9fr 1.2fr;gap:75px;align-items:center; }.ui-kicker { color:#527160;font:800 11px ui-monospace,monospace;letter-spacing:.14em; }.ui-kicker i { display:inline-block;width:8px;height:8px;border-radius:50%;background:#b5e95e;margin-right:8px; }.ui-copy h1 { font-size:clamp(45px,6vw,73px);line-height:1.02;letter-spacing:-.07em;margin:24px 0; }.ui-copy h1 span { color:#739e4b; }.ui-copy p { color:#718078;font-size:18px;line-height:1.7; }.button-lime { color:#203018;background:#b9eb68;box-shadow:0 14px 30px #93c65142; }.ui-link { color:#50685b;font-size:14px;font-weight:700; }.ui-note { display:flex;align-items:center;gap:13px;color:#84918a;font-size:11px;margin-top:56px; }.avatar-stack { display:flex; }.avatar-stack i { width:25px;height:25px;border-radius:50%;background:#d2ddb8;border:2px solid #f5f7f8;margin-right:-7px; }.avatar-stack i:nth-child(2){background:#9cc5b8}.avatar-stack i:nth-child(3){background:#eac39e}.ui-board { display:grid;grid-template-columns:115px 1fr;min-height:390px;background:#fff;border:1px solid #dde5e0;border-radius:13px;box-shadow:0 30px 80px #506e5a24;overflow:hidden; }.ui-sidebar { background:#f7faf7;border-right:1px solid #e5ede7;padding:20px 12px;display:flex;flex-direction:column;gap:10px;color:#819087;font-size:10px; }.ui-sidebar b { font-size:18px;color:#253a2b;margin:2px 8px 34px; }.ui-sidebar span { padding:8px;border-radius:5px; }.ui-sidebar span.active { color:#273c2b;background:#e4f0d5;font-weight:700; }.ui-sidebar small { color:#adb9af;font-size:8px;letter-spacing:.1em;margin:27px 8px 0; }.ui-main { padding:28px; }.ui-main-head { display:flex;justify-content:space-between;color:#2f4737;font-size:17px;font-weight:700; }.ui-main-head small { color:#9eaba1;font-size:10px;font-weight:400; }.ui-metrics { display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:28px; }.ui-metrics div { background:#f7faf7;padding:18px;border:1px