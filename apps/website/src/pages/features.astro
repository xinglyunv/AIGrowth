---
import Layout from '../layouts/Layout.astro';
import { loadSiteConfig } from '../lib/site-config';

const featureDefaults = [
  {
    title: "AI 可见度分析",
    description: "实时监测你的品牌在主流 AI 模型中的被提及频率、推荐权重和上下文情感。覆盖 ChatGPT、Claude、Gemini 等核心模型,系统会在多个维度上评估品牌的 AI 可见度,包括品牌提及率、推荐倾向、情感分析和行业关联度。数据每小时自动刷新,确保你随时掌握最新动态。",
    highlights: ["跨模型品牌提及率对比与趋势分析", "品牌推荐情感分析与正面/负面识别", "行业关联度与上下文语义识别"],
    icon: "brain",
  },
  {
    title: "竞品对比",
    description: "将你的品牌与竞争对手放在同一坐标中进行 AI 可见度的全面对比。系统会分析竞品为何能获得更多 AI 推荐,从内容策略、品牌权威性和行业相关性等维度拆解竞品优势,并提供可操作的提升策略。支持最多 5 个品牌的同步对比分析。",
    highlights: ["多品牌 AI 可见度横向对比与排名", "竞品优势策略拆解与分析报告", "行业差距量化与可达成目标设定"],
    icon: "chart",
  },
  {
    title: "多模型支持",
    description: "支持 10+ 主流 AI 模型的品牌可见度检测,涵盖国际和国内顶尖模型。每个模型的输出都经过独立分析和交叉验证,确保数据全面准确。你可以在一个平台上同时了解品牌在不同 AI 生态中的表现差异,发现各模型之间的共性趋势和独特见解。",
    highlights: ["ChatGPT、Claude、Gemini 等国际模型", "文心一言、通义千问等国内模型", "跨模型交叉验证与一致性分析"],
    icon: "globe",
  },
  {
    title: "智能报告",
    description: "自动生成可视化品牌可见度分析报告,以图表、趋势线和关键指标的形式直观展示数据。报告包含品牌可见度总分、各模型表现、竞品对比雷达图和增长建议清单,支持一键导出 PDF 或通过链接分享,方便在团队内部或向管理层汇报。",
    highlights: ["自动生成可视化分析报告含关键指标", "趋势分析与异常波动智能检测", "一键导出 PDF / 分享报告链接"],
    icon: "document",
  },
  {
    title: "实时监控",
    description: "7x24 小时持续追踪品牌在 AI 模型中的动态变化。当 AI 模型的输出对品牌有新的提及或评价变化时,系统会立即通过邮件或站内通知发送告警。所有历史数据均可回溯,支持按时间线分析品牌 AI 可见度的演变过程,帮助你把握品牌口碑的长期趋势。",
    highlights: ["7x24 自动化持续监控不间断运行", "即时通知与异常变化告警推送", "时间线数据回溯与历史对比分析"],
    icon: "bell",
  },
  {
    title: "增长建议",
    description: "基于 AI 可见度分析数据,系统会生成针对性的品牌增长策略建议。每一条建议都基于数据分析,告诉你应该优化什么、如何优化以及预期效果。建议涵盖内容策略、SEO 优化、品牌权威性建设、社交媒体运营等多个维度,提供完整的优化路线图。",
    highlights: ["数据驱动的品牌优化策略定制", "具体可执行的操作指南与优先级排列", "预期效果量化预估与跟踪反馈"],
    icon: "trend",
  },
];
const settings = await loadSiteConfig();
const features = settings.features.map((feature, index) => ({
  ...featureDefaults[index % featureDefaults.length],
  ...feature,
  highlights: feature.highlights?.length ? feature.highlights : featureDefaults[index % featureDefaults.length].highlights,
  icon: feature.icon || featureDefaults[index % featureDefaults.length].icon,
}));
---

<Layout title={`${settings.site_name} - 功能`} description={settings.site_description}>
  <section class="bg-gradient-to-b from-primary-50 via-white to-white">
    <div class="px-6 pt-28 pb-20 mx-auto max-w-7xl lg:px-12">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-sm font-bold uppercase tracking-wider text-primary-700">{settings.hero.tagline}</p>
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-primary-900 sm:text-5xl">{settings.hero.title}</h1>
        <p class="mt-4 text-lg text-base-500">{settings.hero.subtitle}</p>
      </div>
    </div>
  </section>

  {
    features.map(({ title, description, highlights, icon }, i) => (
      <section class={i % 2 === 0 ? 'bg-white' : 'bg-primary-50'}>
        <div class="px-6 py-20 mx-auto max-w-7xl lg:px-12">
          <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
            <div class={`rounded-xl bg-white ring-1 ring-primary-200 p-8 hover:shadow-md transition duration-300 ${i % 2 === 1 ? 'lg:order-2' : ''}`}>
              <h2 class="text-2xl font-bold text-primary-900">{title}</h2>
              <p class="mt-4 text-sm text-base-500 leading-relaxed">{description}</p>
              <ul class="space-y-3 mt-6">
                {
                  highlights.map((h) => (
                    <li class="flex items-center gap-3 text-sm text-base-500">
                      <svg class="w-4 h-4 text-primary-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {h}
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class={`rounded-xl bg-primary-50 p-8 flex items-center justify-center min-h-48 ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              <div class="text-center">
                {
                  icon === "brain" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                }
                {
                  icon === "chart" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                  </svg>
                }
                {
                  icon === "globe" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                }
                {
                  icon === "document" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                }
                {
                  icon === "bell" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                  </svg>
                }
                {
                  icon === "trend" &&
                  <svg class="w-16 h-16 text-primary-700 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                  </svg>
                }
                <p class="mt-3 text-sm text-primary-700 font-medium">{title}</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-primary-50">
    <div class="px-6 py-20 mx-auto max-w-7xl lg:px-12 text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="text-3xl font-bold tracking-tight text-primary-900 sm:text-4xl">准备好提升品牌 AI 可见度了吗</h2>
        <p class="mt-4 text-base text-base-500">免费注册,即刻开始你的品牌 AI 可见度分析之旅。无需信用卡,3 分钟完成注册。</p>
        <div class="flex flex-wrap items-center justify-center gap-4 mt-10">
          <a href="/app" class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-semibold bg-primary-900 text-white hover:bg-primary-800 transition shadow-sm">免费开始使用</a>
          <a href="/contact" class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-sm font-semibold ring-1 ring-primary-300 text-primary-700 bg-white hover:bg-primary-50 transition">预约演示</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
