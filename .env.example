# ============================================
# AI-Growth-Engine 环境变量模板
# 部署时复制为 .env 并填入实际值
# ============================================

# 运行环境
APP_ENV=development
DOMAIN=localhost

# 数据库 (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password-here
DATABASE_NAME=ai_growth_engine

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=24h

# AI 模型 Key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CLAUDE_API_KEY=
GEMINI_API_KEY=

# 邮件
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# 文件存储
STORAGE_PATH=./storage
UPLOAD_MAX_SIZE=10MB
